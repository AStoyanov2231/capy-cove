# Optional custom PeerJS signaling server. Leave unset to use PeerJS's public service.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true

# Optional TURN relay for restrictive NAT/firewalls.
# IMPORTANT: VITE_* values are PUBLIC in the browser bundle. Never use an account
# secret or long-lived unrestricted relay credential. Production relay access
# should use short-lived credentials from a separately secured service; integrating
# that credential endpoint requires extending src/network/session.ts.
# VITE_TURN_URL=turns:relay.example.com:443?transport=tcp
# VITE_TURN_USERNAME=restricted-demo-user
# VITE_TURN_CREDENTIAL=restricted-demo-credential
